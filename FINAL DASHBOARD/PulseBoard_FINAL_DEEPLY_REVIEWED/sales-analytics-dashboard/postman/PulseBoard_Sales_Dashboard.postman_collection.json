{
  "info": {
    "name": "PulseBoard Sales Dashboard API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://YOUR-API-HOST"
    }
  ],
  "item": [
    {
      "name": "Get Sales Dashboard \u2014 2026-05-25",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/sales-dashboard?date=2026-05-25",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "sales-dashboard"
          ],
          "query": [
            {
              "key": "date",
              "value": "2026-05-25"
            }
          ]
        }
      }
    }
  ]
}